# URL pública, sem barra no final. Em produção, use o domínio da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Acesso da área administrativa. Troque antes de publicar.
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
AUTH_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres

# Banco local. Na Vercel, use um banco Turso: libsql://... e o token.
DATABASE_URL=file:data/galvao-aerial.db
DATABASE_AUTH_TOKEN=
